# Sao chep thanh .env hoac dat trong IDE / docker. KHONG commit file .env that.
DB_URL=jdbc:postgresql://localhost:5432/scanit
DB_USER=scanit
DB_PASSWORD=scanit
# Bat buoc, toi thieu 32 ky tu:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173
# Ten cloud Cloudinary de dung URL anh (khong can API secret de doc anh)
CLOUDINARY_CLOUD_NAME=
# true = tao tai khoan va hang mau luc khoi dong (chi dung khi dev)
SEED_DEV_DATA=false

# --- Luu anh -------------------------------------------------------------
# local = luu trong thu muc MEDIA_LOCAL_DIR (de thu, phuc vu tai /media/**); r2 = Cloudflare R2
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./data/media
# r2: URL cong khai cua bucket (bat "Public access" -> r2.dev, hoac gan ten mien rieng)
MEDIA_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# --- Nhan dien anh -------------------------------------------------------
RECOGNIZER_URL=http://localhost:8001
RECOGNITION_MIN_SCORE=0.55
RECOGNITION_CONFIDENT_SCORE=0.80
